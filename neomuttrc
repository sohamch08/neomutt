# External files
source ~/.config/neomutt/modules/binds.muttrc
source ~/.config/neomutt/modules/colors.muttrc
source ~/.config/neomutt/modules/aliases.muttrc

# Identity
set from                            = "soham.chatterjee@tifr.res.in"

# Paths
set folder                          = "~/.mail/tifr"
set alias_file                      = "~/.config/neomutt/modules/aliases.muttrc"
set header_cache                    = "$HOME/.cache/neomutt/headers"
set message_cache_dir               = "$HOME/.cache/neomutt/bodies"
set certificate_file                = "$HOME/.cache/neomutt/certificates"
set signature                       = "~/.config/neomutt/signature"
set mailcap_path                    = "~/.config/neomutt/mailcap"
set tmpdir                          = "~/.cache/neomut/temp"

# IMAP Inbox
set mbox_type                       = Maildir
set imap_user                       = "soham.chatterjee@tifr.res.in"

# Mail Directories
set spoolfile                       = "+INBOX"
set postponed                       = "+Drafts"
set record                          = "+Sent"
set trash                           = "+Trash"
set mbox                            = "+Archives"
mailboxes +INBOX +Sent +Trash +Drafts +Junk +Archives +Simons "+TCS RSP" +datanet

# Editor
set editor                          = "nvim -f"

# SMTP Sending
# set smtp_url                        = "smtps://soham.chatterjee@tifr.res.in@tifr.res.in:25/"
set sendmail                        = "msmtp -a soham.chatterjee@tifr.res.in"

# Basic behaviour
set wait_key                        = no 
set timeout                         = 3
set mail_check                      = 0
unset confirmappend
set pipe_decode
set thorough_search      
set quit
set sort_re
set use_threads                     = yes
set sort                            = reverse-last-date-received
set sort_aux                        = date-received
set mark_old                        = no
set charset                         = "utf-8"
set to_chars                        = " 󰆎"

# Status Bar
set status_chars = " "
set status_format = "───[ Folder: %f ]───[%r%m messages%?n? (%n new)?%?d? (%d to delete)?%?t? (%t tagged)? ]───%>─%?p?( %p postponed )?───"
# set status_format                   = "-%r-NeoMutt: %D [Msgs:%<M?%M/>%m%<n? New:%n>%<o? Old:%o> %<d? Del:%d>%<F? Flag:%F> %<t? Tag:%t>%<p? Post:%p>%<b? Inc:%b> %<l? %l>]---(%<T?%T/>%s/%S)-%>-(%P)---"

# Index Bar Mail Entries
set index_format                    = "%zc %zs %zt  | %-35.35L   %?M? (%M) ?%-30.100s %> %?Y?%Y ? %(!%a %d %h %H:%M)  "

# Sidebar
set sidebar_visible                 = yes
set sidebar_short_path
set sidebar_folder_indent
set sidebar_divider_char            = ' │'
set sidebar_indent_string           = ' - '
set sidebar_non_empty_mailbox_only  = yes
set sidebar_width                   = 24
set sidebar_format                  = "%D%<F? [%F]>%* %N/%S"

# Alias settings
set alias_format                    = "%3i %f%t %-15a %-23N %E"
set alias_sort                      = "alias"

# Header options
set header_cache_backend            = "lmdb"
ignore *                                # ignore all headers
unignore from: to: cc: date: subject:   # show only these
unhdr_order *                           # some distros order things by default
hdr_order from: to: cc: date: subject:  # and in this order

# Notmuch config
set nm_config_file                  = "~/.config/neomutt/notmuch-config"
set nm_default_url                  = "notmuch:///home/soham/.mail/tifr"


# Some More Config
set mail_check_stats                = yes
set indent_string                   = "> "
set date_format                     = "%m/%d"
set uncollapse_jump
set reply_regexp                    = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"
set quote_regexp                    = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"
set menu_scroll
set tilde

# Pager settings
set pager_index_lines               = 8
set pager_context                   = 3
set pager_stop

# Writing Mails
set realname                        = "Soham Chatterjee"
set envelope_from
set sig_dashes                      = no
set sig_on_top                      = yes
set edit_headers
set fast_reply
set askcc
set fcc_attach                      = yes
set copy                            = yes
unset mime_forward
set forward_format                  = "Fwd: %s"
set forward_decode
set forward_quote                   = yes
set attribution                     = "On %d, %n wrote:"
set reply_to   
set text_flowed                     = yes
set greeting                        = "Hi %n,"
set ispell                          = "ispell"
set include
set sendmail_wait                   = 0

# Address Book setup (Abook)
set query_command                   = "abook --mutt-query %s"
