# Default settings applied to all accounts
defaults
auth                on
tls                 on
tls_trust_file      system
logfile             ~/.config/logs/msmtp.log


# Account definition
account             $TIFR_USER_NAME@tifr.res.in
host                158.144.1.22
port                25
tls_host_override   tifr.res.in
tls_starttls   on
from           $TIFR_USER_NAME@tifr.res.in
user           $TIFR_USER_NAME@tifr.res.in
passwordeval   "gopass show -o mail/TIFR pass"

# Default account
account default : $TIFR_USER_NAME@tifr.res.in
