# vim: set filetype=muttrc :
# Catppuccin Mocha for NeoMutt
# Palette: https://catppuccin.com/palette/#mocha
# Based on https://github.com/catppuccin/neomutt
# Uses the Mocha terminal palette already loaded by Kitty, including in tmux.
# default = Text #cdd6f4 on Base #1e1e2e
# color0 = Surface 1 #45475a; color8 = Surface 2 #585b70
# color1 = Red #f38ba8; color2 = Green #a6e3a1
# color3 = Yellow #f9e2af; color4 = Blue #89b4fa
# color5 = Pink #f5c2e7; color6 = Teal #94e2d5
# color7 = Subtext 1 #bac2de; color15 = Subtext 0 #a6adc8

uncolor *

# Interface: keep ordinary text quiet and use one restrained selection color.
color normal            default       default
color message           default       default
color indicator         default       color0
color status            color15       color0
color tree              color3        default
color signature         color8        default
color attachment        color4        default
color error             color1        default
color tilde             color8        default
color search            color0        color3
color markers           color8        default

# Message states, following the hierarchy in colors.muttrc.
color index             color1        default  ~F
color index             color4        default  ~N
color index             color4        default  ~O
color index             color3        color0   ~T
color index             color8        default  ~D

# Quoted replies. Ordinary body text keeps its natural formatting.
color quoted            color6        default
color quoted1           color4        default
color quoted2           color2        default
color quoted3           color5        default
color quoted4           color7        default
color quoted5           color6        default
color quoted6           color4        default
color quoted7           color2        default
color quoted8           color5        default
color quoted9           color7        default

# Headers: distinct accents, without forcing bold throughout the message.
color hdrdefault        color6        default
color header            color5        default  '^date:'
color header            color4        default  '^(to|cc|bcc):'
color header            color2        default  '^from:'
color header            color3        default  '^subject:'
color header            color7        default  '^user-agent:'
color header            color6        default  '^reply-to:'

# Sidebar: share the message background instead of painting a second panel.
color sidebar_background default      default
color sidebar_ordinary   color7       default
color sidebar_spool_file default      default
color sidebar_divider    color8       default
color sidebar_flagged    color3       default
color sidebar_unread     color4       default
color sidebar_new        color4       default
color sidebar_highlight  default      color0
color sidebar_indicator  default      color0

