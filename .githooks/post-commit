#!/usr/bin/env bash
set -euo pipefail

# Stop the database commit from triggering another database commit.
if [[ "${NEOMUTT_DATABASE_COMMIT:-0}" == 1 ]]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if [[ -d "$(git rev-parse --git-path rebase-merge)" || -d "$(git rev-parse --git-path rebase-apply)" ]]; then
  exit 0
fi

# A path-limited parent commit can leave a temporary index in the environment.
unset GIT_INDEX_FILE

files=(modules/aliases.muttrc.gpg abook/addressbook.gpg)

if ! git add -- "${files[@]}"; then
  echo "ERROR: Your normal commit succeeded, but the encrypted backups could not be staged." >&2
  echo "Fix the Git error above, then run ./.githooks/post-commit to retry." >&2
  exit 1
fi

if git diff --cached --quiet -- "${files[@]}"; then
  exit 0
fi

# --only includes these two paths and leaves other staged changes alone.
if ! NEOMUTT_DATABASE_COMMIT=1 git commit --only -m "updated database" -- "${files[@]}"; then
  echo "ERROR: Your normal commit succeeded, but the separate database commit failed." >&2
  echo "Fix the error above, then run ./.githooks/post-commit to retry." >&2
  exit 1
fi
