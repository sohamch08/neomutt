#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

for file in modules/aliases.muttrc abook/addressbook; do
  if git ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
    echo "ERROR: Plaintext contacts are tracked: $file" >&2
    echo "Keep the local file but remove it from Git's index with:" >&2
    echo "  git rm --cached -- '$file'" >&2
    echo "Then open '$PWD/.gitignore' in your editor." >&2
    echo "If equivalent rules are not already present, add these lines at the end:" >&2
    echo "  /$file" >&2
    echo "  !/$file.gpg" >&2
    echo "The first rule ignores plaintext; the second allows its encrypted backup." >&2
    echo "Save .gitignore, run 'git add -- .gitignore', and retry the commit." >&2
    exit 1
  fi
done

# The separate database commit must not encrypt or unstage its own files.
if [[ "${NEOMUTT_DATABASE_COMMIT:-0}" == 1 ]]; then
  exit 0
fi

# Do not add new database commits while Git is replaying history.
if [[ -d "$(git rev-parse --git-path rebase-merge)" || -d "$(git rev-parse --git-path rebase-apply)" ]]; then
  exit 0
fi

if [[ ! -x ./scripts/contacts-gpg.sh ]]; then
  echo "ERROR: scripts/contacts-gpg.sh is missing or is not executable." >&2
  echo "Restore the script if missing, then run: chmod +x scripts/contacts-gpg.sh" >&2
  exit 1
fi

if ! ./scripts/contacts-gpg.sh backup; then
  echo "ERROR: Contact backup failed. Commit cancelled; encrypted backups were not staged by this hook." >&2
  echo "Fix the error reported above and retry the commit." >&2
  exit 1
fi

# Keep encrypted contacts out of the normal commit, even after git add -A.
# This changes only their staged versions; the encrypted files stay on disk.
git reset -q -- modules/aliases.muttrc.gpg abook/addressbook.gpg
